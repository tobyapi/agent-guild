{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theme Backdrop Recipe v1",
  "description": "背景レシピの構造契約。版規則と追加検証は theme-backdrop-recipe.md を参照。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "title", "seed", "palette", "composition", "layers"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "catalogVersion": { "type": "integer", "const": 1 },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$"
    },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dark", "light"],
      "properties": {
        "dark": { "$ref": "#/$defs/colors" },
        "light": { "$ref": "#/$defs/colors" }
      }
    },
    "composition": { "type": "string", "const": "quietCenter" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "colors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "motif", "anchor", "color", "scale", "density", "depth", "motion"],
      "properties": {
        "kind": { "type": "string", "enum": ["tile", "halftone", "paper", "symbol"] },
        "motif": { "type": "string" },
        "anchor": { "type": "string", "enum": ["left", "right", "bottomLeft", "bottomRight"] },
        "color": { "type": "integer", "minimum": 1, "maximum": 7 },
        "scale": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "density": { "type": "number", "minimum": 0, "maximum": 1 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 3 },
        "motion": { "type": "string", "enum": ["none", "drift", "sway"] }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "tile" },
            "motif": { "enum": ["star", "cross", "dot", "wave", "seaweed", "tree", "turtle"] },
            "depth": { "const": 1 },
            "motion": { "const": "none" }
          }
        },
        {
          "properties": {
            "kind": { "const": "halftone" },
            "motif": { "enum": ["hill", "cloud", "wave"] },
            "depth": { "const": 1 },
            "motion": { "const": "none" }
          }
        },
        {
          "properties": {
            "kind": { "const": "paper" },
            "motif": { "enum": ["hill", "cloud", "wave", "seaweed", "tree", "turtle", "aurora"] },
            "density": { "const": 0.5 }
          },
          "oneOf": [
            { "properties": { "motion": { "const": "none" } } },
            {
              "properties": {
                "motif": { "enum": ["cloud", "wave", "turtle", "aurora"] },
                "motion": { "const": "drift" }
              }
            },
            {
              "properties": {
                "motif": { "enum": ["tree", "seaweed"] },
                "motion": { "const": "sway" }
              }
            }
          ]
        },
        {
          "properties": {
            "kind": { "const": "symbol" },
            "motif": { "enum": ["star", "cross", "dot", "wave", "seaweed", "tree", "turtle"] },
            "depth": { "const": 1 }
          },
          "oneOf": [
            { "properties": { "motion": { "const": "none" } } },
            {
              "properties": {
                "motif": { "enum": ["tree", "seaweed"] },
                "motion": { "const": "sway" }
              }
            }
          ]
        }
      ]
    }
  }
}
