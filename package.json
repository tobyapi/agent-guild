{
  "name": "agent-guild",
  "version": "0.1.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "runner": "node agent-runner/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p agent-runner/tsconfig.json",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint": "eslint .",
    "test": "vitest run",
    "harness": "node --test \"scripts/harness/**/*.test.mjs\" && node scripts/harness/check-ts.mjs",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run harness && npm run test && npm run rust:clippy && npm run rust:test"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@microsoft/mxc-sdk": "1.0.1",
    "@openai/codex-sdk": "^0.167.0",
    "@tauri-apps/api": "^2.12.4",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": ">=5.8 <6.1",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "private": true,
  "license": "MIT"
}
